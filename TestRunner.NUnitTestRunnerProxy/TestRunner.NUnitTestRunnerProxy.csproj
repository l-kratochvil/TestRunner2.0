<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net481</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>

		<!-- COM props -->
		<!--<RegisterForComInterop>true</RegisterForComInterop>-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NUnit" Version="4.3.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TestRunner.Common\TestRunner.Common.csproj" />
	</ItemGroup>

	<!-- Ensure the reg-free COM manifest ships next to the server DLL (disabled by default; in-proc not supported from .NET 8) -->
	<ItemGroup Condition="'$(BuildRegFreeInProc)'=='true'">
		<None Include="TestRunner.NUnitTestRunnerProxy.X.manifest">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="CopyExchangeFiles" AfterTargets="Build">
		<PropertyGroup>
			<DestinationDir>$(ExchangeDir)$(AssemblyName).X\</DestinationDir>
		</PropertyGroup>

		<ItemGroup>
			<OutFile Include="$(TargetDir)\**\*" />
		</ItemGroup>

		<RemoveDir Directories="$(DestinationDir)" />
		<Copy SourceFiles="@(OutFile)" DestinationFiles="$(DestinationDir)%(OutFile.RecursiveDir)%(OutFile.Filename)%(OutFile.Extension)" />
	</Target>
</Project>
