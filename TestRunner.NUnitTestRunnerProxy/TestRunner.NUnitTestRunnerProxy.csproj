<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net481</TargetFramework>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="NUnit" Version="4.3.2" />
		<PackageReference Include="StreamJsonRpc" Version="2.21.10" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\TestRunner.Common\TestRunner.Common.csproj" />
	</ItemGroup>
	
	<Target Name="CopyExchangeFiles" AfterTargets="Build">
		<PropertyGroup>
			<DestinationDir>$(NUnitTestRunnerProxyDir)$(AssemblyName)\</DestinationDir>
		</PropertyGroup>
		
		<ItemGroup>
			<OutFile Include="$(TargetDir)\**\*" />
		</ItemGroup>
		<RemoveDir Directories="$(DestinationDir)" />
		<Copy SourceFiles="@(OutFile)" DestinationFiles="$(DestinationDir)%(OutFile.RecursiveDir)%(OutFile.Filename)%(OutFile.Extension)" />
	</Target>
	
</Project>
