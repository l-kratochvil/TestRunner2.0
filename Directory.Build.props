<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>			 
		<!-- Common props -->
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)\Key.snk</AssemblyOriginatorKeyFile>
		<!-- Output exchange props -->
		<ExchangeDir>$(SolutionDir)Exchange\</ExchangeDir>
		<NUnitTestRunnerProxyDir>$(ExchangeDir)NUnitTestRunnerProxy\</NUnitTestRunnerProxyDir>
		<NUnitTestAssembliesDir>$(ExchangeDir)NUnitTestAssemblies\</NUnitTestAssembliesDir>
		<IncludeNUnitTestRunnerProxyDirOutput Condition="'$(IncludeNUnitTestRunnerProxyDirOutput)' == ''">false</IncludeNUnitTestRunnerProxyDirOutput>
	</PropertyGroup>
</Project>