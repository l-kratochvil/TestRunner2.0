@* Feature: TestDiscovery — "the user can browse and select tests to run". *@

@inject TestRunStore Store

<section class="test-explorer">
    <h2 class="pane-title">Test Explorer</h2>

    @if (this.viewModel.IsEmpty)
    {
        <p class="placeholder-note">No tests loaded.</p>
    }
    else
    {
        <ul class="test-tree">
            @foreach (TestNodeViewModel root in this.viewModel.Roots)
            {
                <TestTreeNode Node="root" @key="root.ExecutionPath" SelectionChanged="this.OnSelectionChangedAsync" />
            }
        </ul>
    }
</section>

@code {
    private TestExplorerViewModel viewModel = TestExplorerViewModel.Create([]);

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        this.viewModel = TestExplorerViewModel.Create(this.Store.Current.LoadedTestSuites);
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // What the user selected last is kept in the browser, which a circuit can only reach once
        // it is interactive. The tree is therefore drawn unselected first and marked up afterwards.
        await this.Store.InitializeAsync();

        this.viewModel.ApplySelection(this.Store.Current.SelectedTestCasesPaths);
        this.StateHasChanged();
    }

    private Task OnSelectionChangedAsync()
        => this.Store.UpdateAsync(state => state with
        {
            SelectedTestCasesPaths = this.viewModel.SelectedTestCasesPaths,
        });
}
