@* Feature: TestConfiguration — "the user can configure a test run". *@

@using System.Linq
@using Fluxor

@using TestRunner.WebApp.Shared.Domain
@using TestRunner.WebApp.Shared.Stores.AppSettings
@using TestRunner.WebApp.Shared.Stores.TestConfiguration
@using TestRunner.WebApp.Shared.Stores.TestDiscovery

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<section class="test-configurator">
    <h2 class="pane-title">Configuration</h2>

    <DataContext Data="@this.viewModel">
        <PropertyGrid>
            <PropertyGridRow Label="Runtime version">
                <BindingSelect
                    Class="configuration-runtime-version"
                    Binding="@(vm => vm.RuntimeVersion)"
                    Options="this.viewModel.RuntimeVersions"
                    Placeholder="—" />
            </PropertyGridRow>

            @if (this.viewModel.IsRuntimeTest)
            {
                <PropertyGridRow Label="HW assembly type">
                    <BindingSelect
                        Class="configuration-test-station"
                        Binding="@(vm => vm.TestedHwAssembly)"
                        Options="TestStationLabels.Offered.Cast<TestedHwAssemblyType?>()"
                        Placeholder="—" />
                </PropertyGridRow>
            }

            <PropertyGridRow Label="Write to TestLink">
                <BindingCheckbox 
                    Class="configuration-testlink"
                    Binding="@(vm => vm.IsWriteToTestLinkEnabled)" />
            </PropertyGridRow>

            @if (this.viewModel.IsWriteToTestLinkEnabled)
            {               
                <BindingInput 
                    Class="configuration-ide-version"
                    Binding="@(vm => vm.IdeVersion)"
                    Placeholder="X.Y.Z" />
            }
        </PropertyGrid>
    </DataContext>
</section>

@code {
    private TestConfigurationViewModel viewModel = null!;

    /// <summary>
    /// Gets or sets the configuration this component reads and edits.
    /// </summary>
    [Inject]
    private IState<TestConfigurationState> TestConfigurationState { get; set; } = null!;

    /// <summary>
    /// Gets or sets the dispatcher configuration changes are sent through.
    /// </summary>
    [Inject]
    private IDispatcher Dispatcher { get; set; } = null!;

    [Inject]
    private IAppLoggerFactory LoggerFactory { get; set; } = null!;

    /// <summary>
    /// Gets or sets the store the test selection is read from.
    /// </summary>
    [Inject]
    private ITestDiscoveryStore TestDiscoveryStore { get; set; } = null!;

    /// <summary>
    /// Gets or sets the store the application settings are read from.
    /// </summary>
    [Inject]
    private IAppSettingsStore AppSettingsStore { get; set; } = null!;

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        base.OnInitialized();

        this.viewModel = new TestConfigurationViewModel(
            this.TestConfigurationState,
            this.AppSettingsStore,
            this.LoggerFactory,
            this.Dispatcher);

        this.viewModel.Initialize();
    }
}