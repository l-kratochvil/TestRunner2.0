@using TestRunner.WebApp.Shared.Validation
@typeparam TValue

<Validated Validity=@this.Validity>
    <input @attributes="this.AdditionalAttributes"
           value="@this.Value"
           @oninput="this.OnInput"/>
</Validated>

@code {
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public Func<TValue?, Validity>? Validator { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    
    private Validity? Validity { get; set; }

    private async Task OnInput(ChangeEventArgs args)
    {
        if (args.Value is not TValue value)
        {
            return;
        }

        this.Validity = this.Validator?.Invoke(value);
        if (!(this.Validity?.HasErrors ?? false))
        {
            return;
        }

        await this.ValueChanged.InvokeAsync(value);
    }
}