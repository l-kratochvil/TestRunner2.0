@* One property of a property grid: its name, its input, and what is wrong with it.

   The row renders no wrapper of its own, so its label and its value land straight in the grid of
   the parent — which is what keeps every label in one column and every input in the other. *@

@using TestRunner.WebApp.Components.Primitives

<label class="property-label" for="@this.For">@this.Label</label>

<div class="property-value">
    @this.ChildContent

    @if (!string.IsNullOrEmpty(this.Message))
    {
        <p class="property-message @(this.Severity == PropertyMessageSeverity.Warning ? "is-warning" : "is-error")"
           role="@(this.Severity == PropertyMessageSeverity.Warning ? "status" : "alert")">
            @this.Message
        </p>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the property label.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the id of the input this label targets.
    /// </summary>
    [Parameter]
    public string? For { get; set; }

    /// <summary>
    /// Gets or sets the message shown under the property.
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// Gets or sets the <see cref="PropertyMessageSeverity"/> of <see cref="Message"/>.
    /// </summary>
    [Parameter]
    public PropertyMessageSeverity Severity { get; set; } = PropertyMessageSeverity.Error;

    /// <summary>
    /// Gets or sets the input shown for the property.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
