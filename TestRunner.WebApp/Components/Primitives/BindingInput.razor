@* An input bound to one property of the view model cascaded to it.

   What the tester types is text, so the input is what a value that is not text is converted through
   on its way to the view model and back. *@

@using System.ComponentModel
@using System.Globalization

@typeparam TDataContext where TDataContext : class, INotifyPropertyChanged
@typeparam TBindingValue

@inherits BindingComponentBase<TDataContext, TBindingValue>

<Validated Validity="this.Validity">
    @* TODO: Use @bind instead of value and @oninput? *@
    <input @attributes="this.AdditionalAttributes"
           class="@($"form-control form-control-sm {this.Class}")"
           value="@BindConverter.FormatValue(this.CurrentValue)"
           @oninput="this.OnInputAsync" />
</Validated>

@code {
    private async Task OnInputAsync(ChangeEventArgs args)
    {
        // The browser hands every edit over as text, so anything that is not text has to be
        // converted before it can be written back. What does not convert is not something the view
        // model could hold, and is left where the tester typed it instead of overwriting it.
        if (!BindConverter.TryConvertTo(args.Value, CultureInfo.CurrentCulture, out TBindingValue? value))
        {
            return;
        }

        await this.WriteAsync(value);
    }
}
