{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false
  },
  // Any .ts anywhere in the project compiles in place to a .js next to it - for collocated Razor
  // scripts ({Component}.razor.ts) that sibling location is where the Blazor SDK expects the .js.
  // wwwroot/lib is vendored third-party code, bin/obj are build outputs.
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "bin", "obj", "wwwroot/lib"]
}
