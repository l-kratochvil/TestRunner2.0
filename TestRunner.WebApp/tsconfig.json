{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false
  },
  // Every Razor component's collocated script lives at Components/**/{Component}.razor.ts and
  // compiles in place to Components/**/{Component}.razor.js, which is where the Blazor SDK
  // expects to find it.
  "include": ["Components/**/*.ts"]
}
